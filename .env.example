# Gemini (optional — chatbot)
GEMINI_API_KEY=

# Frontend API base. Leave empty in dev to use Vite proxy → Django :8000
# Production example: https://api.yourdomain.com/api
VITE_API_URL=

# Optional override for Vite proxy target
VITE_PROXY_TARGET=http://127.0.0.1:8010

# Optional: Google Client ID for GIS button (also exposed by Django /api/auth/google/config/)
# VITE_GOOGLE_CLIENT_ID=
